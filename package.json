{
  "name": "primestone-motion-studio",
  "productName": "Primestone Motion Studio",
  "version": "0.1.0",
  "description": "Primestone Motion Studio — local-first professional video editor",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/build.mjs && playwright test --trace off",
    "dist:win": "node scripts/build.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vite": "^8.0.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
