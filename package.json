{
  "name": "primestone-motion-studio",
  "productName": "Primestone Motion Studio",
  "version": "0.4.0-dev",
  "description": "Primestone Motion Studio \u2014 local-first professional video editor",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/build.mjs && playwright test --trace off",
    "dist:win": "node scripts/build.mjs && electron-builder --win --x64 --publish never",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs gpl"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vite": "^8.0.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "an-array-of-english-words": "^2.0.0",
    "an-array-of-french-words": "^2.0.0",
    "immer": "^11.2.10",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "com.primestone.motionstudio",
    "productName": "Primestone Motion Studio",
    "copyright": "Copyright \u00a9 2026 Primestone",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tools/transcribe",
        "to": "transcribe",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "assets/pcore",
        "to": "pcore",
        "filter": [
          "logo-gold.webp",
          "logo-shape.json"
        ]
      }
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "psproj",
        "name": "Primestone Project",
        "description": "Primestone Motion Studio project"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "author": "Primestone"
}
